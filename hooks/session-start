#!/usr/bin/env bash
# SessionStart hook: inject the router — and optionally a base role and per-project
# context — into every session.
#
# Without this, using-matej-skills is just another skill competing for the model's
# attention, and the conflicts between the vendored upstreams go unsettled.
# With it, the rulings are always in context. This is the whole reason the plugin
# surface exists alongside `npx skills add`.
#
# This is the bundle's ONLY SessionStart script on purpose (see the using-superpowers
# exclusion in sources.json): one script, multiple tagged blocks — never a second
# competing SessionStart entry.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
ROUTER="${PLUGIN_ROOT}/skills/matej/using-matej-skills/SKILL.md"
BASE_ROLE="${PLUGIN_ROOT}/skills/matej/base-role/SKILL.md"
PROJECT_CONTEXT="${CLAUDE_PROJECT_DIR:-${PWD}}/.claude/xmmm1-context.md"
UPDATE_NOTICE="${XDG_STATE_HOME:-${HOME}/.local/state}/xmmm1-skills/pending-notice.txt"

# Daily skills refresh: detached and silent (hook stdout is session context), so it can't
# slow or pollute this session. Its result is shown at the NEXT session start, below.
nohup "${SCRIPT_DIR}/auto-update" </dev/null >/dev/null 2>&1 &

# Buffer the context blocks so they can be wrapped in JSON when there is an update notice to
# show the user. fd 3 keeps the real stdout; restored at the bottom.
CONTEXT_FILE="$(mktemp)"
trap 'rm -f "${CONTEXT_FILE}"' EXIT
exec 3>&1 1>"${CONTEXT_FILE}"

# Strip the YAML frontmatter: it's installer metadata, not instructions.
strip_frontmatter() { sed '1{/^---$/!q;};1,/^---$/d' "$1"; }

if [ -f "${ROUTER}" ]; then
  router_body="$(strip_frontmatter "${ROUTER}")"
  cat <<EOF
<using-matej-skills>
The following rulings come from this bundle's router. Two vendored skill sets
(mattpocock/skills and obra/superpowers) cover overlapping ground and contradict
each other in places; a third (coreyhaines31/marketingskills) covers marketing and
conflicts with neither. These rulings settle those conflicts and take precedence
over the individual skills' own wording.

${router_body}
</using-matej-skills>
EOF
else
  echo "using-matej-skills not found at ${ROUTER}" >&2 # never block a session over it
fi

# Base role: ships as an inert scaffold. Injected only once the user has replaced the
# placeholder text (the PLACEHOLDER marker is the off switch).
if [ -f "${BASE_ROLE}" ] && ! grep -q 'PLACEHOLDER' "${BASE_ROLE}"; then
  role_body="$(strip_frontmatter "${BASE_ROLE}")"
  cat <<EOF

<base-role>
The following base role/behavior ships with this bundle and applies in every project
where it is installed, unless the project's own instructions say otherwise.

${role_body}
</base-role>
EOF
fi

# Per-project context: a host repo opts in by creating .claude/xmmm1-context.md.
# Absent file = no output, zero noise.
if [ -f "${PROJECT_CONTEXT}" ]; then
  cat <<EOF

<project-context>
Project-specific context provided by this repository (.claude/xmmm1-context.md):

$(cat "${PROJECT_CONTEXT}")
</project-context>
EOF
fi

exec 1>&3 3>&-

# An auto-update happened (or failed) since the last session: tell the user. `systemMessage`
# is displayed to them; the context block makes the model mention it too. The notice is
# deleted only once it has been emitted. No notice, or no node to build the JSON -> plain output.
if [ -s "${UPDATE_NOTICE}" ] && command -v node >/dev/null 2>&1 &&
  node -e '
    const fs = require("fs");
    const context = fs.readFileSync(0, "utf8");
    const notice = fs.readFileSync(process.argv[1], "utf8").trim();
    process.stdout.write(JSON.stringify({
      systemMessage: notice,
      hookSpecificOutput: {
        hookEventName: "SessionStart",
        additionalContext: context + "\n<skills-auto-update>\n" + notice +
          "\nMention this to the user in one short line in your first reply.\n</skills-auto-update>\n",
      },
    }));
  ' "${UPDATE_NOTICE}" <"${CONTEXT_FILE}"; then
  rm -f "${UPDATE_NOTICE}"
else
  cat "${CONTEXT_FILE}"
fi
